{
  "name": "zaha-app",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/web"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=api",
    "dev:mobile": "npm run start --workspace=mobile",
    "dev:web": "npm run dev --workspace=zaha-web-legacy",
    "build:api": "npm run build --workspace=api",
    "lint:api": "npm run lint --workspace=api"
  }
}
