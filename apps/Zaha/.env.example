# Copier ce fichier en .env et remplir les valeurs.
# Uniquement des clés PUBLIQUES : tout est embarqué en clair dans l'APK.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>

# IP LAN du PC qui héberge l'API Next.js (ex : 192.168.1.164).
# Sur Android, localhost désigne le téléphone lui-même.
LOCAL_API_HOST=192.168.1.X

# Domaine de l'API déployée sur Vercel (utilisé dans les builds release).
# Sans https:// — ex : zaha-c2w5t5d87-soad2.vercel.app
PROD_API_HOST=zaha-c2w5t5d87-soad2.vercel.app
